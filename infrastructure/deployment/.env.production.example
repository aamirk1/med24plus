# ==============================================================================
# Med24Plus Production Environment Variables
# Copy to .env.production on VPS: cp .env.production.example .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=med24plus_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD_32_CHARS
POSTGRES_DB=med24plus_db
POSTGRES_PORT=5432
POSTGRES_SERVER=postgres
DATABASE_URL=postgresql+asyncpg://med24plus_user:CHANGE_ME_TO_STRONG_DB_PASSWORD_32_CHARS@postgres:5432/med24plus_db

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD_32_CHARS
REDIS_URL=redis://:CHANGE_ME_TO_STRONG_REDIS_PASSWORD_32_CHARS@redis:6379/0

# ------------------------------------------------------------------------------
# 3. Application Security & Authentication
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=Med24Plus
API_V1_STR=/api/v1

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATED_OPENSSL_HEX_KEY_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Prescription Signed URL HMAC Secret (Rule 65 Compliance)
PRESCRIPTION_HMAC_SECRET=CHANGE_ME_PRESCRIPTION_HMAC_KEY_64_CHARS

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://med24plus.serwex.in","https://med24plus-admin.serwex.in"]

# ------------------------------------------------------------------------------
# 5. Frontend Client API Endpoints (Bake during Docker build)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://med24plus-api.serwex.in/api/v1
