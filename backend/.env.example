# Environment Settings
PROJECT_NAME="Med24Plus"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="pharmacy_user"
POSTGRES_PASSWORD="pharmacy_secure_dev_pass_2026"
POSTGRES_DB="med24plus_db"
DATABASE_URL="postgresql+asyncpg://pharmacy_user:pharmacy_secure_dev_pass_2026@localhost:5432/med24plus_db"
SYNC_DATABASE_URL="postgresql+psycopg2://pharmacy_user:pharmacy_secure_dev_pass_2026@localhost:5432/med24plus_db"

# Redis Cache
REDIS_URL="redis://:redis_dev_secret_2026@localhost:6379/0"

# JWT Authentication
JWT_SECRET_KEY="change_me_super_secret_jwt_key_at_least_32_chars_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON Array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Storage Configuration (Private S3 bucket for prescriptions, public for products)
STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
STORAGE_BUCKET="med24plus-private-prescriptions"
STORAGE_ACCESS_KEY="placeholder_storage_key"
STORAGE_SECRET_KEY="placeholder_storage_secret"

# Indian Payment & SMS Gateways (Placeholders)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
MSG91_AUTH_KEY="msg91_auth_placeholder"

