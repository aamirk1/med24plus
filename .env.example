# ==============================================================================
# Med24Plus Root Environment Configuration Template
# ==============================================================================

# Project Details
PROJECT_NAME="Med24Plus"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=pharmacy_user
POSTGRES_PASSWORD=pharmacy_secure_dev_pass_2026
POSTGRES_DB=med24plus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pharmacy_user:pharmacy_secure_dev_pass_2026@localhost:5432/med24plus_db

# Redis Cache & Task Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret_2026
REDIS_URL=redis://:redis_dev_secret_2026@localhost:6379/0

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# Security & JWT Authentication
JWT_SECRET_KEY=change_me_super_secret_jwt_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON string array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Object Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=s3_compatible
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET_PRESCRIPTIONS=med24plus-private-prescriptions
STORAGE_BUCKET_PRODUCTS=med24plus-public-products
STORAGE_ACCESS_KEY=your_storage_access_key_placeholder
STORAGE_SECRET_KEY=your_storage_secret_key_placeholder

# Payment Gateway (Razorpay / Cashfree - India)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
CASHFREE_APP_ID=cashfree_app_id_placeholder
CASHFREE_SECRET_KEY=cashfree_secret_key_placeholder

# SMS & WhatsApp OTP Gateway (Msg91 / Fast2SMS - India)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=msg91_auth_key_placeholder
MSG91_OTP_TEMPLATE_ID=msg91_template_placeholder
FAST2SMS_API_KEY=fast2sms_api_key_placeholder

# Frontend URLs
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:8000

